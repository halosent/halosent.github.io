{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      "node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/articles",
        "destination": "/articles.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/start-here",
        "destination": "/start-here.html"
      },
      {
        "source": "/church-fathers",
        "destination": "/church-fathers.html"
      },
      {
        "source": "/library",
        "destination": "/library.html"
      },
      {
        "source": "/glossary",
        "destination": "/glossary.html"
      },
      {
        "source": "/verses",
        "destination": "/verses.html"
      },
      {
        "source": "/sources",
        "destination": "/sources.html"
      }
    ]
  }
}